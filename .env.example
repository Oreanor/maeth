VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Talking to the pieces — server-side only. Either key is enough; with neither,
# the cloud on the board simply never appears (same providers as Star Elite).
#
# БЕЗ префикса VITE_: всё, что с ним, Vite вкомпилирует в публичный бандл, и
# ключ сможет забрать любой, кто откроет исходники страницы. Читает их только
# api/chat.ts.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Необязательно: свой список моделей через запятую, если провайдер вывел
# нынешние из обращения (тогда запросы отвечают 404).
GROQ_MODELS=
OPENROUTER_MODELS=
# Необязательно: сколько реплик один игрок может получить за сутки (по умолчанию 400).
CHAT_DAILY_LIMIT=
