{
  "name": "maeth",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Mini-chess 4x4 game for the browser",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch scripts/dev-api.mts",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev\"",
    "dev:vercel": "vercel dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^5.8.12",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "vercel": "^54.9.1",
    "vite": "^5.4.0"
  }
}
