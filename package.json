{
  "name": "maeth",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Mini-chess 4x4 game for the browser",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch scripts/dev-api.mts",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev\"",
    "dev:vercel": "vercel dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "generate:favicon": "tsx scripts/generate-favicon.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.20",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "@vercel/node": "^5.8.12",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "vercel": "^54.9.1",
    "vite": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
